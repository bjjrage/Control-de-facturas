# Supabase project (local: run `npx supabase start` and copy the printed values,
# or use `npx supabase status` after it's running)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Base URL used to build provider portal links (/cotizar/{token})
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server-only): used to read photos of paper invoices (GPT-4o-mini vision)
OPENAI_API_KEY=replace-with-openai-api-key
