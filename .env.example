# Supabase project (local: run `npx supabase start` and copy the printed values,
# or use `npx supabase status` after it's running)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Base URL used to build provider portal links (/cotizar/{token})
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server-only): used to read photos of paper invoices (GPT-4o-mini vision)
OPENAI_API_KEY=replace-with-openai-api-key

# DeepSeek (server-only): matcher semántico BIM <-> presupuesto (lib/bim/deepseek-matcher.ts).
# Solo necesaria para generar sugerencias de match en el módulo BIM y para la
# suite live-semantic-matching.spec.ts (RUN_LIVE_BIM_AI_TESTS=1). Nunca se expone al browser.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# --- Worker de parseo async (worker/index.ts, corre en Railway) ---
# En Railway seteá estas 3 como variables del servicio:
#   SUPABASE_URL=<mismo valor que NEXT_PUBLIC_SUPABASE_URL>
#   SUPABASE_SERVICE_ROLE_KEY=<mismo que arriba>
#   OPENAI_API_KEY=<mismo que arriba>
# Local: el worker toma NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY de este archivo.
# WORKER_POLL_MS=2500

# --- Goekua — Facturación Electrónica SIFEN (goekua.com.py) ---
# Sin estas variables el botón "Emitir FE" aparece pero muestra error informativo.
# Obtener en https://goekua.com.py luego de contratar el plan API.
GOEKUA_API_KEY=replace-with-goekua-api-key
GOEKUA_BASE_URL=https://api.goekua.com.py
# Datos del establecimiento emisor (definidos en el portal SIFEN de la SET):
GOEKUA_ESTABLISHMENT_ID=1
GOEKUA_ESTABLISHMENT_ADDRESS=Calle Principal 123, Asunción
GOEKUA_ESTABLISHMENT_NAME=Nombre del establecimiento
GOEKUA_POINT_OF_EXPEDITION=001
# Timbrado vigente (número de autorización de la SET):
GOEKUA_TIMBRADO=12345678
