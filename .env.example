# Supabase project (local: run `npx supabase start` and copy the printed values,
# or use `npx supabase status` after it's running)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Base URL used to build provider portal links (/cotizar/{token})
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server-only): used to read photos of paper invoices (GPT-4o-mini vision)
OPENAI_API_KEY=replace-with-openai-api-key

# --- Worker de parseo async (worker/index.ts, corre en Railway) ---
# En Railway seteá estas 3 como variables del servicio:
#   SUPABASE_URL=<mismo valor que NEXT_PUBLIC_SUPABASE_URL>
#   SUPABASE_SERVICE_ROLE_KEY=<mismo que arriba>
#   OPENAI_API_KEY=<mismo que arriba>
# Local: el worker toma NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY de este archivo.
# WORKER_POLL_MS=2500
