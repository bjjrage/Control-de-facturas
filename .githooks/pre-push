#!/bin/sh
zero="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$local_sha" = "$zero" ]; then
      echo "BLOCKED: no se permite eliminar main." >&2
      exit 1
    fi

    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "BLOCKED: no se permite force-push o actualización no fast-forward de main." >&2
      exit 1
    fi

    echo "BLOCKED: el push directo a main está prohibido; integrar sólo un batch revisado mediante PR." >&2
    exit 1
  fi
done
